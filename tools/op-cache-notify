#!/usr/bin/env python3
"""Watch the op-cache audit log and raise a macOS notification for the two
things a permanently open cache can no longer show by itself.

Everlast fork only. With `unlock --all` refreshed on a timer, secrets are
served without any approval prompt, so the prompt no longer works as a signal
that something read a credential. This restores a signal without restoring the
friction:

  * an `op://` reference or item name asked for fewer than `rare_threshold`
    times in the trailing week - the class a foreign process falls into, since
    the routine working set is small and repetitive.
  * more than `rate_threshold` requests within the trailing hour - a burst,
    whatever asked for it.

The counts live in the state file, not in the log. The log rotates at 5 MB and
can be truncated or deleted; a history that is rebuilt from it would then read
every routine reference as first-time and say so, loudly, exactly when it is
least useful.

It reads only the audit log, never the Keychain, and the log holds references
and item names, never field values.

Runs from a LaunchAgent every minute; state lives in
~/.local/state/op-cache-notify/state.json.
"""

from __future__ import annotations

import errno
import json
import os
import subprocess
import sys
import unicodedata
from datetime import datetime, timedelta, timezone
from pathlib import Path


def path_from(variable: str, default: str) -> Path:
    return Path(os.path.expanduser(os.environ.get(variable, default)))


LOG = path_from("OP_CACHE_AUDIT_LOG", "~/Library/Logs/op-cache-audit.jsonl")
STATE = path_from("OP_CACHE_NOTIFY_STATE", "~/.local/state/op-cache-notify/state.json")
CONFIG = path_from("OP_CACHE_NOTIFY_CONFIG", "~/.config/op-cache/notify.json")
# Prints the notifications it would raise instead of raising them. The tests
# and a hand check need to see the text without a banner on every run.
DRY_RUN = "--dry-run" in sys.argv

DEFAULTS = {
    # Fewer than this many requests for the same subject in the trailing week
    # makes the request worth showing.
    "rare_threshold": 3,
    "rare_window_days": 7,
    # Requests in the trailing hour above this raise a burst warning.
    "rate_threshold": 50,
    # Never repeat the burst warning more often than this.
    "rate_cooldown_minutes": 60,
    # One notification per run at most; more subjects than this are summarised
    # in the banner. The full list always goes to stdout, which launchd keeps
    # in ~/Library/Logs/op-cache-notify.log.
    "max_named_subjects": 4,
    "enabled": True,
}

# Call kinds that reach a credential, cached or not. `metadata` is a listing:
# it carries no field value, but naming the vault someone enumerated is the
# whole point of this watcher, so it counts too.
NAMED_KINDS = {"secret", "item-store", "metadata", "passthrough", "mutating"}

# Bumped whenever the meaning of the stored history changes. A state written
# by an older version is treated as no state at all: its history would be
# incomplete for the new counting and every gap would read as a rare fetch.
STATE_VERSION = 2


def load_config() -> dict:
    config = dict(DEFAULTS)
    try:
        loaded = json.loads(CONFIG.read_text())
    except FileNotFoundError:
        return config
    except (OSError, ValueError) as error:
        warn(f"config ignored: {error}")
        return config
    if not isinstance(loaded, dict):
        warn("config ignored: not an object")
        return config
    # A wrong type must not turn every minute's run into a traceback with no
    # notification behind it; the key falls back to its default and says so.
    for key, value in loaded.items():
        if key not in DEFAULTS:
            warn(f"config: unknown key {key!r} ignored")
            continue
        if not isinstance(value, type(DEFAULTS[key])) or isinstance(value, bool) != isinstance(
            DEFAULTS[key], bool
        ):
            warn(f"config: {key} must be {type(DEFAULTS[key]).__name__}, using default")
            continue
        config[key] = value
    return config


def load_state() -> dict:
    try:
        state = json.loads(STATE.read_text())
    except (OSError, ValueError):
        return {}
    return state if isinstance(state, dict) else {}


def save_state(state: dict) -> None:
    # The state mirrors every reference from the audit log, which is 0600. It
    # gets the same mode: an item-name history is a map of what is worth
    # stealing.
    STATE.parent.mkdir(parents=True, exist_ok=True)
    tmp = STATE.with_suffix(".tmp")
    descriptor = os.open(tmp, os.O_CREAT | os.O_TRUNC | os.O_WRONLY, 0o600)
    with os.fdopen(descriptor, "w") as handle:
        handle.write(json.dumps(state))
    os.chmod(tmp, 0o600)
    tmp.replace(STATE)


def warn(message: str) -> None:
    print(f"op-cache-notify: {message}", file=sys.stderr)


def parse_time(value: str) -> datetime | None:
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00"))
    except (AttributeError, TypeError, ValueError):
        return None


def stamp(moment: datetime) -> str:
    return moment.isoformat().replace("+00:00", "Z")


def subjects_of(entry: dict) -> list[str]:
    secrets = entry.get("secrets")
    if isinstance(secrets, list):
        named = [
            secret["reference"]
            for secret in secrets
            if isinstance(secret, dict) and isinstance(secret.get("reference"), str)
        ]
        if named:
            return named
    # Entries written before the proxy named its subject carry only the
    # subcommand. Counting it the way the proxy now does keeps `item list` and
    # `whoami` routine across the upgrade instead of new three times over.
    subcommand = entry.get("subcommand")
    # The prefetch (`unlock --all`) is such an entry too: no references, only
    # `subcommand: prefetch` - and it is the one call that touches everything.
    if entry.get("event") in ("proxy", "unlock") and isinstance(subcommand, str) and subcommand:
        return [subcommand]
    return []


def plain(subject: str) -> str:
    """One line, one field: a subject with a tab or newline in it must not be
    able to forge a second record in the stdout log."""
    cleaned = "".join(
        " " if ch in "\t\n\r" or ord(ch) < 32 or unicodedata.category(ch) in ("Cf", "Cc")
        else ch
        for ch in subject
    )
    return cleaned if cleaned.strip() else "(leer)"


def reaches_a_secret(entry: dict) -> bool:
    """Whether the entry is worth naming. Proxy calls carry a kind; `run`
    injects a whole profile into a child and `unlock` fetches one, and neither
    has a kind - both reach secrets all the same."""
    if entry.get("event") in ("run", "unlock"):
        return True
    return entry.get("cacheKind") in NAMED_KINDS


def notify(title: str, message: str) -> bool:
    """Raise the banner. Returns whether it was handed to the system - a caller
    that records "warned" must not do so on a failed osascript. Handed to is
    all that can be known: when Notification Center declines to show a banner
    (TCC), osascript still exits 0. The stdout lines are the durable record."""
    if DRY_RUN:
        print(f"NOTIFY\t{title}\t{message}")
        return True

    # osascript keeps this dependency-free. Quotes and backslashes are the only
    # metacharacters inside an AppleScript string literal, and a subject comes
    # from a command line someone else wrote, so both are escaped.
    def quote(text: str) -> str:
        return text.replace("\\", "\\\\").replace('"', '\\"')

    script = f'display notification "{quote(message)}" with title "{quote(title)}"'
    try:
        subprocess.run(["osascript", "-e", script], check=True, capture_output=True)
    except (OSError, subprocess.CalledProcessError) as error:
        warn(f"notification failed: {error}")
        return False
    return True


class SingleRun:
    """One run at a time. Two runs sharing a state file would each count the
    same entries and could name the same subject twice."""

    def __init__(self, path: Path) -> None:
        self.path = path.with_suffix(".lock")
        self.held = False

    def __enter__(self) -> "SingleRun":
        self.path.parent.mkdir(parents=True, exist_ok=True)
        try:
            handle = os.open(self.path, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
        except OSError as error:
            if error.errno != errno.EEXIST:
                raise
            # A run that died leaves its lock behind; ten minutes is far longer
            # than a run needs (measured: 0.04s) and short enough to recover on
            # the next tick.
            try:
                age = datetime.now().timestamp() - self.path.stat().st_mtime
            except OSError:
                age = 0
            if age < 600:
                warn(f"another run holds the lock ({int(age)}s), skipping")
                return self
            try:
                self.path.unlink()
                handle = os.open(self.path, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
            except OSError:
                return self
        os.write(handle, str(os.getpid()).encode())
        os.close(handle)
        self.held = True
        return self

    def __exit__(self, *_: object) -> None:
        if self.held:
            try:
                self.path.unlink()
            except OSError:
                pass


def read_new_entries(
    path: Path, offset: int, after: datetime | None, now: datetime
) -> tuple[list[tuple[dict, datetime]], int]:
    """Entries written since the last run, with the log's size. Two guards,
    because either can be wrong on its own: the byte offset misses nothing but
    resets to zero when the log rotates, and the timestamp survives rotation
    but has one-second resolution."""
    entries: list[tuple[dict, datetime]] = []
    size = 0
    with path.open("rb") as handle:
        for raw in handle:
            start = size
            size += len(raw)
            if start < offset:
                continue
            try:
                entry = json.loads(raw)
            except ValueError:
                continue
            if not isinstance(entry, dict):
                continue
            moment = parse_time(entry.get("timestamp", ""))
            if moment is None:
                # An entry that names a secret is not dropped for a bad clock;
                # it is counted as of now. Only a line past the offset gets
                # here, so it cannot be an old one seen again.
                if not subjects_of(entry):
                    continue
                moment = now
            elif after is not None and moment < after:
                continue
            entries.append((entry, moment))
    return entries, size


def main() -> int:
    config = load_config()
    if not config.get("enabled", True):
        return 0
    if not LOG.exists():
        return 0

    now = datetime.now(timezone.utc)
    window = timedelta(days=config["rare_window_days"])
    rare_threshold = config["rare_threshold"]

    with SingleRun(STATE) as lock:
        if not lock.held:
            return 0

        state = load_state()
        # No history means no baseline - whether the file is missing or was
        # written by the earlier version that kept none. Either way the first
        # run must only record what is routine, never announce it.
        history = state.get("history")
        first_run = not isinstance(history, dict) or state.get("version") != STATE_VERSION
        if first_run:
            history = {}
            state = {}
        offset = state.get("offset", 0)
        if not isinstance(offset, int) or offset < 0:
            offset = 0
        last_seen = parse_time(state.get("last_seen", ""))
        requests = state.get("requests")
        if not isinstance(requests, list):
            requests = []

        try:
            # A log that shrank was rotated or truncated, and the byte offset
            # then points past its end: everything would be skipped and the
            # watcher would go quiet for good. Start from the front instead and
            # let `last_seen` keep the entries it already counted out. Only
            # then: on an intact log the offset alone is exact, and a timestamp
            # filter would drop a late writer whose stamp predates its append.
            # Two signs of a rotation: the file shrank, or it is a different
            # file (the rotated log is renamed away and a new one created).
            # Size alone misses a new log that has already outgrown the old
            # offset by the time the watcher looks again.
            stat = LOG.stat()
            old_inode = state.get("inode") if isinstance(state.get("inode"), int) else None
            rotated = stat.st_size < offset or (old_inode is not None and old_inode != stat.st_ino)
            entries = []
            if rotated and not first_run:
                # The rotated file keeps whatever was written between the last
                # tick and the rename. op-cache moves it to `<log>.1`; when that
                # is the file the offset belongs to, finish reading it first.
                previous = LOG.with_name(LOG.name + ".1")
                tail_read = False
                try:
                    if previous.stat().st_ino == old_inode:
                        entries, _ = read_new_entries(previous, offset, None, now)
                        tail_read = True
                except OSError:
                    pass
                offset = 0
                # With the tail accounted for, the new file is new from its
                # first byte and needs no timestamp guard; without it the
                # guard is what keeps the old entries from counting twice.
                if tail_read:
                    last_seen = None
            fresh, size = read_new_entries(
                LOG, 0 if first_run else offset, last_seen if rotated else None, now
            )
            entries += fresh
        except OSError as error:
            warn(f"log unreadable: {error}")
            return 0

        # Everything new is reported, however old: a run that was asleep with
        # the Mac must not consume the one request that happened meanwhile.
        rare: dict[str, int] = {}
        for entry, moment in entries:
            requests.append(stamp(moment))
            for subject in subjects_of(entry):
                seen = history.get(subject)
                seen = seen if isinstance(seen, list) else []
                before = len(seen)
                seen.append(stamp(moment))
                history[subject] = seen
                if (
                    not first_run
                    and reaches_a_secret(entry)
                    and before < rare_threshold
                    and subject not in rare
                ):
                    rare[subject] = before

        # Trim both histories to the window they are counted over.
        cut = stamp(now - window)
        history = {
            subject: [seen for seen in stamps if seen >= cut]
            for subject, stamps in history.items()
        }
        history = {subject: stamps for subject, stamps in history.items() if stamps}
        hour_cut = stamp(now - timedelta(hours=1))
        requests = [seen for seen in requests if seen >= hour_cut]

        if rare:
            # Least-seen first, so a banner that has to cut the list cuts the
            # routine end, not an alphabetical one. The full list goes to
            # stdout, which launchd keeps in the notify log.
            ordered = sorted(rare.items(), key=lambda item: (item[1], item[0]))
            for subject, before in ordered:
                print(f"RARE\t{before + 1}\t{plain(subject)}")
            limit = max(1, config["max_named_subjects"])
            parts = [f"{plain(subject)} ({before + 1}.)" for subject, before in ordered[:limit]]
            body = ", ".join(parts)
            if len(ordered) > limit:
                body += f" und {len(ordered) - limit} weitere"
            days = config["rare_window_days"]
            notify(
                f"op-cache: {len(ordered)} seltene Abfrage" + ("n" if len(ordered) > 1 else ""),
                f"{body} — Abruf Nr. in {days} Tagen, Schwelle {rare_threshold}",
            )

        rate_threshold = config["rate_threshold"]
        last_alert = parse_time(state.get("last_rate_alert", "")) or datetime.min.replace(
            tzinfo=timezone.utc
        )
        cooldown = timedelta(minutes=config["rate_cooldown_minutes"])
        # The baseline run is silent on this too; a burst that was already
        # under way when the watcher started is reported on the next tick.
        if not first_run and len(requests) > rate_threshold and now - last_alert >= cooldown:
            # On stdout as well: a banner leaves no trace once dismissed, and
            # osascript exits 0 even when the system declined to show it.
            print(f"BURST\t{len(requests)}\t{rate_threshold}")
            delivered = notify(
                "op-cache: ungewöhnlich viele Abfragen",
                f"{len(requests)} Anfragen in der letzten Stunde (Schwelle {rate_threshold})",
            )
            if delivered:
                state["last_rate_alert"] = stamp(now)

        if entries:
            state["last_seen"] = stamp(entries[-1][1])
        state["version"] = STATE_VERSION
        state["offset"] = size
        state["inode"] = stat.st_ino
        state["history"] = history
        state["requests"] = requests
        state["last_run"] = stamp(now)
        save_state(state)
    return 0


if __name__ == "__main__":
    sys.exit(main())
