#!/bin/zsh
# Keep the prefetched item cache warm, so op calls are answered without an
# approval prompt.
#
# Everlast fork only. `unlock --all` holds for the TTL (3d, the fork's cap) and
# then silently lapses; every call after that prompts again, which is what made
# the prompts come back after a single manual unlock. This runs on a timer and
# re-warms only when the cache has actually run dry, so the cost is one Touch ID
# every few days rather than one per call.
#
# It deliberately does nothing while the screen is locked or outside working
# hours: the unlock needs a biometric approval, and a dialog nobody is there to
# answer is worse than a cold cache.

set -u

OP_CACHE="${OP_CACHE_BIN:-$HOME/.local/bin/op-cache}"
LOCK="${TMPDIR:-/tmp}/op-cache-warm.lock"
TTL="${OP_CACHE_WARM_TTL:-3d}"
START_HOUR="${OP_CACHE_WARM_START:-7}"
END_HOUR="${OP_CACHE_WARM_END:-23}"
# Longer than a full prefetch takes (measured: about two and a half minutes for
# 1,100 items), short enough that an hourly timer recovers by itself.
STALE_LOCK_SECONDS="${OP_CACHE_WARM_STALE_LOCK:-1800}"
# Vaults across both accounts (13 + 4, measured 13.09.2026). Fewer than this
# means one account did not warm.
MIN_VAULTS="${OP_CACHE_WARM_MIN_VAULTS:-17}"

log() { print -r -- "$(date '+%Y-%m-%d %H:%M:%S') $*"; }

[[ -x "$OP_CACHE" ]] || { log "op-cache not found at $OP_CACHE"; exit 1; }

hour=$(date +%-H)
if (( hour < START_HOUR || hour >= END_HOUR )); then
    log "outside ${START_HOUR}-${END_HOUR}h, skipping"
    exit 0
fi

if ioreg -n Root -d1 -a 2>/dev/null | grep -q 'CGSSessionScreenIsLocked'; then
    log "screen locked, skipping"
    exit 0
fi

# One warm-up at a time: the unlock takes minutes and the timer fires hourly.
if ! mkdir "$LOCK" 2>/dev/null; then
    # A run killed mid-unlock leaves its lock behind. Without this the cache
    # would never be warmed again, and nothing would say so.
    age=$(( $(date +%s) - $(stat -f %m "$LOCK" 2>/dev/null || date +%s) ))
    if (( age < STALE_LOCK_SECONDS )); then
        log "another warm-up holds the lock (${age}s), skipping"
        exit 0
    fi
    log "breaking a stale lock (${age}s old)"
    rmdir "$LOCK" 2>/dev/null
    if ! mkdir "$LOCK" 2>/dev/null; then
        log "lock still held after breaking it, skipping"
        exit 0
    fi
fi
trap 'rmdir "$LOCK" 2>/dev/null' EXIT INT TERM

# Not named `status`: zsh reserves it as a read-only alias for `$?`, and the
# assignment fails at run time rather than at parse time.
items_status=$("$OP_CACHE" status _items 2>&1)
rc=$?
unlocked=$(print -r -- "$items_status" | sed -n 's/^prefetched vaults: \([0-9][0-9]*\) unlocked.*/\1/p')

# An unreadable status is not a cold cache. Warming on it would answer a
# crashed or reworded status command with a biometric prompt, which is the one
# thing this script exists to avoid.
if (( rc != 0 )) || [[ -z "$unlocked" ]]; then
    log "status unreadable (exit $rc): ${items_status:0:200}"
    exit 1
fi

# Coverage, not presence. One account can time out on its approval while the
# other warms, and "at least one vault" would then never repair it - measured
# on 13.09.2026: 13 vaults warm, the second account's 4 skipped, and nothing
# would have noticed. The expected count is the measured total of both
# accounts; a lower number is a partial warm-up and gets redone.
if (( unlocked >= MIN_VAULTS )); then
    log "cache warm ($unlocked vaults), nothing to do"
    exit 0
fi

if (( unlocked > 0 )); then
    log "cache partly warm ($unlocked of $MIN_VAULTS vaults), running unlock --all --ttl $TTL"
else
    log "cache cold, running unlock --all --ttl $TTL"
fi
if "$OP_CACHE" unlock --all --ttl "$TTL"; then
    log "warm: $("$OP_CACHE" status _items | head -1)"
else
    code=$?
    log "unlock failed with exit $code"
    exit $code
fi
