#!/bin/zsh
# Keep the prefetched item cache warm, so op calls are answered without an
# approval prompt.
#
# Everlast fork only. `unlock --all` holds for the TTL (3d, the fork's cap) and
# then silently lapses; every call after that prompts again, which is what made
# the prompts come back after a single manual unlock. This runs on a timer and
# re-warms only when the cache has actually run dry, so the cost is one Touch ID
# every few days rather than one per call.
#
# It deliberately does nothing while the screen is locked or outside working
# hours: the unlock needs a biometric approval, and a dialog nobody is there to
# answer is worse than a cold cache.

set -u

OP_CACHE="${OP_CACHE_BIN:-$HOME/.local/bin/op-cache}"
# Lock and retry stamp live in a fixed per-user directory, not in TMPDIR: the
# LaunchAgent and a terminal must see the same lock, and TMPDIR is set per
# session.
STATE_DIR="${OP_CACHE_WARM_STATE_DIR:-$HOME/.local/state/op-cache-warm}"
LOCK="$STATE_DIR/op-cache-warm.lock"
TTL="${OP_CACHE_WARM_TTL:-3d}"
START_HOUR="${OP_CACHE_WARM_START:-7}"
END_HOUR="${OP_CACHE_WARM_END:-24}"
# Longer than a full prefetch takes (measured: about two and a half minutes for
# 1,100 items), short enough that an hourly timer recovers by itself.
STALE_LOCK_SECONDS="${OP_CACHE_WARM_STALE_LOCK:-1800}"
# A partial warm-up is retried no more often than this (6h).
PARTIAL_RETRY_SECONDS="${OP_CACHE_WARM_PARTIAL_RETRY:-21600}"
RETRY_STAMP="$STATE_DIR/op-cache-warm.last-attempt"
PARTIAL_MARK="$STATE_DIR/op-cache-warm.partial"
UNLOCK_OUT="$STATE_DIR/op-cache-warm.unlock-output"

log() { print -r -- "$(date '+%Y-%m-%d %H:%M:%S') $*"; }

[[ -x "$OP_CACHE" ]] || { log "op-cache not found at $OP_CACHE"; exit 1; }
mkdir -p "$STATE_DIR" || { log "cannot create $STATE_DIR"; exit 1; }

hour=$(date +%-H)
if (( hour < START_HOUR || hour >= END_HOUR )); then
    log "outside ${START_HOUR}-${END_HOUR}h, skipping"
    exit 0
fi

screen_locked() {
    # Overridable so the tests can run on a locked or unlocked machine alike;
    # the real check is the CoreGraphics session flag.
    if [[ -n "${OP_CACHE_WARM_SCREEN_LOCKED_CMD:-}" ]]; then
        eval "$OP_CACHE_WARM_SCREEN_LOCKED_CMD"
        return
    fi
    ioreg -n Root -d1 -a 2>/dev/null | grep -q 'CGSSessionScreenIsLocked'
}

if screen_locked; then
    log "screen locked, skipping"
    exit 0
fi

# One warm-up at a time: the unlock takes minutes and the timer fires hourly.
# The lock names its holder, and a holder that is still alive keeps it however
# old it is - an approval dialog left open for an hour is still one dialog, and
# a second unlock beside it would make it two. Only a dead holder's lock is
# broken, and only once it is old enough that a killed run is the likely cause.
if ! mkdir "$LOCK" 2>/dev/null; then
    holder=$(cat "$LOCK/pid" 2>/dev/null)
    if [[ -n "$holder" ]] && kill -0 "$holder" 2>/dev/null; then
        log "another warm-up (pid $holder) holds the lock, skipping"
        exit 0
    fi
    age=$(( $(date +%s) - $(stat -f %m "$LOCK" 2>/dev/null || date +%s) ))
    if (( age < STALE_LOCK_SECONDS )); then
        log "lock held by a finished run (${age}s), waiting for it to age out"
        exit 0
    fi
    log "breaking a stale lock (${age}s old, holder ${holder:-unknown} gone)"
    rm -f "$LOCK/pid"; rmdir "$LOCK" 2>/dev/null
    if ! mkdir "$LOCK" 2>/dev/null; then
        log "lock still held after breaking it, skipping"
        exit 0
    fi
fi
print -r -- $$ > "$LOCK/pid"
trap 'rm -f "$LOCK/pid"; rmdir "$LOCK" 2>/dev/null' EXIT INT TERM

# Not named `status`: zsh reserves it as a read-only alias for `$?`, and the
# assignment fails at run time rather than at parse time.
items_status=$("$OP_CACHE" status _items 2>&1)
rc=$?
unlocked=$(print -r -- "$items_status" | sed -n 's/^prefetched vaults: \([0-9][0-9]*\) unlocked.*/\1/p')
expired=$(print -r -- "$items_status" | sed -n 's/^prefetched vaults: [0-9][0-9]* unlocked, \([0-9][0-9]*\) expired.*/\1/p')

# An unreadable status is not a cold cache. Warming on it would answer a
# crashed or reworded status command with a biometric prompt, which is the one
# thing this script exists to avoid.
if (( rc != 0 )) || [[ -z "$unlocked" ]]; then
    log "status unreadable (exit $rc): ${items_status:0:200}"
    exit 1
fi

# Coverage, not presence. One account can time out on its approval while the
# others warm, and "at least one vault" would then never repair it - measured
# on 13.09.2026: two accounts warm, the third skipped, and nothing would have
# noticed. The unlock itself says which accounts it skipped; that line is kept
# as a marker, and a marked warm-up is redone after the retry interval. A
# vault count would not do: empty vaults do not count as unlocked, so the
# number moves with the vaults' contents.
# An expired bundle counts as cold: a retry for one account gives that
# account a later expiry than the rest, so the main account can lapse while
# "unlocked" still reads above zero. That is the ordinary three-day rewarm,
# and it is done for every account at once so the expiries line up again.
if (( ${expired:-0} > 0 )); then
    log "cache partly expired ($unlocked warm, $expired expired vaults), treating as cold"
    unlocked=0
fi

if (( unlocked > 0 )); then
    if [[ ! -f "$PARTIAL_MARK" ]]; then
        log "cache warm ($unlocked vaults), nothing to do"
        exit 0
    fi
    # A partial warm-up means an account did not approve. Retrying every hour
    # would turn a persistently absent approval into an hourly dialog, so a
    # retry waits; a fully cold cache is always worth the attempt.
    last=$(cat "$RETRY_STAMP" 2>/dev/null)
    since=$(( $(date +%s) - ${last:-0} ))
    if (( since < PARTIAL_RETRY_SECONDS )); then
        log "cache partly warm ($unlocked vaults; $(cat "$PARTIAL_MARK")), last attempt ${since}s ago, waiting"
        exit 0
    fi
    # Only the accounts that dropped out are retried: every account in an
    # unfiltered unlock costs its own approval, and the warm ones need none.
    # The marker holds their URLs, which `--account` accepts.
    only=$(tr ';' '\n' < "$PARTIAL_MARK" | sed -E 's/^skipped //; s/: no vaults visible$//' | paste -sd, -)
    account_filter=(--account "$only")
    log "cache partly warm ($unlocked vaults; $(cat "$PARTIAL_MARK")), running unlock --all --account $only --ttl $TTL"
    # Only a retry of a partial warm-up starts the wait. A cold run that ends
    # short (a write to 1Password wiped the vaults it had already prefetched)
    # gets one prompt retry on the next tick before the six hours apply.
    date +%s > "$RETRY_STAMP"
else
    account_filter=()
    log "cache cold, running unlock --all --ttl $TTL"
    rm -f "$RETRY_STAMP"
fi

# The unlock runs as a child whose pid is what the lock names: when this
# script is killed, the lock must still say who is actually holding the
# dialog open, and a TERM here ends the child rather than orphaning it.
"$OP_CACHE" unlock --all "${account_filter[@]}" --ttl "$TTL" > "$UNLOCK_OUT" 2>&1 &
child=$!
print -r -- "$child" > "$LOCK/pid"
trap 'kill -TERM "$child" 2>/dev/null; rm -f "$LOCK/pid"; rmdir "$LOCK" 2>/dev/null' EXIT INT TERM
if wait "$child"; then
    cat "$UNLOCK_OUT"
    log "warm: $("$OP_CACHE" status _items | head -1)"
    # The unlock names every account it skipped. Keep that as the marker for
    # the next tick; without it a skipped account would never be retried, and
    # with a silent retry nobody would learn that it keeps being skipped.
    # Two ways an account drops out: its approval timed out ("skipped
    # <account>: …"), or it authenticated and then listed no vaults
    # ("<account>: no vaults visible, skipping"). Both leave the marker.
    skipped=$(grep -oE 'skipped [^:]+|[^ ]+: no vaults visible' "$UNLOCK_OUT" | sort -u | tr '\n' ';' | sed 's/;$//')
    if [[ -n "$skipped" ]]; then
        print -r -- "$skipped" > "$PARTIAL_MARK"
        if [[ -f "$RETRY_STAMP" ]]; then
            log "partial: $skipped - next retry in $((PARTIAL_RETRY_SECONDS / 3600))h"
        else
            log "partial: $skipped - one more try on the next tick, then every $((PARTIAL_RETRY_SECONDS / 3600))h"
        fi
    else
        rm -f "$PARTIAL_MARK" "$RETRY_STAMP"
    fi
else
    code=$?
    cat "$UNLOCK_OUT"
    log "unlock failed with exit $code"
    # A marker naming an account op no longer knows would fail like this
    # every six hours for ever; drop it, the next cold run sees what exists.
    if grep -q 'No matching 1Password accounts' "$UNLOCK_OUT"; then
        log "marker names an account op does not know, dropping it"
        rm -f "$PARTIAL_MARK" "$RETRY_STAMP"
    fi
    exit $code
fi
