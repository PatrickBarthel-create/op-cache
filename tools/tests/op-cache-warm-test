#!/bin/zsh
# Tests for op-cache-warm. Every branch is exercised against a stub op-cache,
# so no test ever reaches 1Password or asks for an approval.
#
# The stub is the point: the branch that matters is the one that decides to
# prompt, and it must never fire on a status it could not read.

set -u

TOOL="${0:A:h:h}/op-cache-warm"
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

typeset -i failures=0

check() {
    local name=$1 condition=$2 detail=${3:-}
    if [[ "$condition" == "1" ]]; then
        print "ok   $name"
    else
        print "FAIL $name $detail"
        (( failures++ ))
    fi
}

stub() {  # stub <name> <exit> <output...>
    local path="$WORK/$1"
    {
        print '#!/bin/sh'
        print "cat <<'OUT'"
        print -r -- "$3"
        print 'OUT'
        print "exit $2"
    } > "$path"
    /bin/chmod +x "$path"
    print -r -- "$path"
}

run() {  # run <op-cache-stub> [env assignments...]
    local bin=$1; shift
    env OP_CACHE_WARM_SCREEN_LOCKED_CMD=false OP_CACHE_BIN="$bin" OP_CACHE_WARM_STATE_DIR="$WORK/tmp" "$@" "$TOOL" 2>&1
    return $?
}

mkdir -p "$WORK/tmp"

# 1. A warm cache is left alone - no unlock, no prompt.
warm=$(stub warm 0 'prefetched vaults: 17 unlocked, 0 expired')
out=$(run "$warm" OP_CACHE_WARM_START=0 OP_CACHE_WARM_END=24)
check "warm cache does nothing" $([[ "$out" == *"nothing to do"* && "$out" != *"unlock"* ]] && print 1 || print 0) "$out"

# 2. A cold cache warms up.
cold=$(stub cold 0 'prefetched vaults: 0 unlocked, 0 expired')
out=$(run "$cold" OP_CACHE_WARM_START=0 OP_CACHE_WARM_END=24)
check "cold cache runs unlock" $([[ "$out" == *"cache cold, running unlock"* ]] && print 1 || print 0) "$out"

# 2b. A warm-up that skipped an account leaves a marker and is redone; a
#     warm cache without a marker is left alone, whatever its vault count.
partial=$(stub partial 0 'prefetched vaults: 8 unlocked, 0 expired
  skipped strategie-fm.1password.eu: [ERROR] authorization timeout
Unlocked 945 item(s) from 14 vault(s) in 2 account(s)')
rm -f "$WORK/tmp/op-cache-warm.last-attempt" "$WORK/tmp/op-cache-warm.partial"
out=$(run "$cold" OP_CACHE_WARM_START=0 OP_CACHE_WARM_END=24)
check "a full unlock leaves no marker" $([[ ! -f "$WORK/tmp/op-cache-warm.partial" ]] && print 1 || print 0)
out=$(run "$partial" OP_CACHE_WARM_START=0 OP_CACHE_WARM_END=24)
check "a warm cache without a marker is left alone" $([[ "$out" == *"nothing to do"* ]] && print 1 || print 0) "$out"
# Cold run against the skipping stub: the unlock reports the skipped account.
rm -f "$WORK/tmp/op-cache-warm.partial"
coldskip=$(stub coldskip 0 'prefetched vaults: 0 unlocked, 0 expired
  skipped strategie-fm.1password.eu: [ERROR] authorization timeout')
out=$(run "$coldskip" OP_CACHE_WARM_START=0 OP_CACHE_WARM_END=24)
check "a skipped account is logged and marked" $([[ "$out" == *"partial: skipped strategie-fm.1password.eu"* && -f "$WORK/tmp/op-cache-warm.partial" ]] && print 1 || print 0) "$out"
out=$(run "$partial" OP_CACHE_WARM_START=0 OP_CACHE_WARM_END=24)
check "a marked warm cache is redone" $([[ "$out" == *"partly warm (8 vaults; skipped strategie-fm"* && "$out" == *"running unlock"* ]] && print 1 || print 0) "$out"

# 2c. An account that authenticated but listed no vaults is marked too, and
#     two dropped accounts both appear in the marker.
rm -f "$WORK/tmp/op-cache-warm.partial" "$WORK/tmp/op-cache-warm.last-attempt"
novaults=$(stub novaults 0 'prefetched vaults: 0 unlocked, 0 expired
  momento-kuechen.1password.com: no vaults visible, skipping
  skipped strategie-fm.1password.eu: [ERROR] authorization timeout')
out=$(run "$novaults" OP_CACHE_WARM_START=0 OP_CACHE_WARM_END=24)
mark=$(cat "$WORK/tmp/op-cache-warm.partial" 2>/dev/null)
check "no-vaults account is marked" $([[ "$mark" == *"momento-kuechen.1password.com: no vaults visible"* ]] && print 1 || print 0) "$mark"
check "both dropped accounts are in the marker" $([[ "$mark" == *"skipped strategie-fm.1password.eu"* ]] && print 1 || print 0) "$mark"
check "a cold partial says the next tick retries" $([[ "$out" == *"one more try on the next tick"* ]] && print 1 || print 0) "$out"

# 3. An unreadable status must NOT be read as cold: that would prompt.
broken=$(stub broken 1 'irgendein Fehler')
out=$(run "$broken" OP_CACHE_WARM_START=0 OP_CACHE_WARM_END=24)
rc=$?
check "failing status does not unlock" $([[ "$out" == *"status unreadable"* && "$out" != *"running unlock"* ]] && print 1 || print 0) "$out"
check "failing status exits non-zero" $([[ $rc -ne 0 ]] && print 1 || print 0) "rc=$rc"

reworded=$(stub reworded 0 'vaults prefetched: 17')
out=$(run "$reworded" OP_CACHE_WARM_START=0 OP_CACHE_WARM_END=24)
check "reworded status does not unlock" $([[ "$out" == *"status unreadable"* ]] && print 1 || print 0) "$out"

# 4. Outside working hours nothing happens, whatever the cache says.
# An empty window at the current hour excludes it whatever the clock says.
now_hour=$(date +%-H)
out=$(run "$cold" OP_CACHE_WARM_START=$now_hour OP_CACHE_WARM_END=$now_hour)
check "outside hours skips" $([[ "$out" == *"outside ${now_hour}-${now_hour}h"* && "$out" != *"unlock"* ]] && print 1 || print 0) "$out"

# 5. A missing op-cache is an error, not a silent pass.
out=$(env OP_CACHE_WARM_SCREEN_LOCKED_CMD=false OP_CACHE_BIN=/gibts/nicht OP_CACHE_WARM_STATE_DIR="$WORK/tmp" "$TOOL" 2>&1)
rc=$?
check "missing op-cache fails loudly" $([[ "$out" == *"not found"* && $rc -ne 0 ]] && print 1 || print 0) "rc=$rc $out"

# 6. A lock whose holder is alive defers however old it is; a dead holder's
#    lock ages out; a fresh lock of a dead holder is still respected.
mkdir -p "$WORK/tmp/op-cache-warm.lock"
sleep 300 &
alive=$!
print -r -- "$alive" > "$WORK/tmp/op-cache-warm.lock/pid"
touch -t 202601010000 "$WORK/tmp/op-cache-warm.lock"
out=$(run "$cold" OP_CACHE_WARM_START=0 OP_CACHE_WARM_END=24)
check "live holder keeps an old lock" $([[ "$out" == *"pid $alive) holds the lock"* && "$out" != *"running unlock"* ]] && print 1 || print 0) "$out"
kill "$alive" 2>/dev/null; wait "$alive" 2>/dev/null

print -r -- 999999 > "$WORK/tmp/op-cache-warm.lock/pid"
touch "$WORK/tmp/op-cache-warm.lock"
out=$(run "$cold" OP_CACHE_WARM_START=0 OP_CACHE_WARM_END=24)
check "fresh lock of a dead holder waits" $([[ "$out" == *"waiting for it to age out"* && "$out" != *"running unlock"* ]] && print 1 || print 0) "$out"

touch -t 202601010000 "$WORK/tmp/op-cache-warm.lock"
out=$(run "$cold" OP_CACHE_WARM_START=0 OP_CACHE_WARM_END=24)
check "stale lock of a dead holder is broken" $([[ "$out" == *"breaking a stale lock"* && "$out" == *"running unlock"* ]] && print 1 || print 0) "$out"
check "lock is released afterwards" $([[ ! -d "$WORK/tmp/op-cache-warm.lock" ]] && print 1 || print 0)

# 7. A partial warm-up is retried only after the retry interval; a cold cache always.
rm -f "$WORK/tmp/op-cache-warm.last-attempt"
print -r -- "skipped strategie-fm.1password.eu " > "$WORK/tmp/op-cache-warm.partial"
out=$(run "$partial" OP_CACHE_WARM_START=0 OP_CACHE_WARM_END=24)
check "first partial retry runs" $([[ "$out" == *"running unlock"* ]] && print 1 || print 0) "$out"
out=$(run "$partial" OP_CACHE_WARM_START=0 OP_CACHE_WARM_END=24)
check "second partial retry within the interval waits" $([[ "$out" == *"last attempt"* && "$out" != *"running unlock"* ]] && print 1 || print 0) "$out"
out=$(run "$coldskip" OP_CACHE_WARM_START=0 OP_CACHE_WARM_END=24)
check "a cold cache ignores the retry interval" $([[ "$out" == *"running unlock"* ]] && print 1 || print 0) "$out"
date +%s > "$WORK/tmp/op-cache-warm.last-attempt"
out=$(run "$partial" OP_CACHE_WARM_START=0 OP_CACHE_WARM_END=24 OP_CACHE_WARM_PARTIAL_RETRY=0)
check "retry interval is configurable" $([[ "$out" == *"running unlock"* ]] && print 1 || print 0) "$out"

# 8. The lock names the unlock child, and a TERM to the script ends it.
slow=$(stub slow 0 'prefetched vaults: 0 unlocked, 0 expired')
{
    print '#!/bin/sh'
    print 'if [ "$1" = "status" ]; then echo "prefetched vaults: 0 unlocked, 0 expired"; exit 0; fi'
    print 'sleep 60'
} > "$slow"
env OP_CACHE_WARM_SCREEN_LOCKED_CMD=false OP_CACHE_BIN="$slow" OP_CACHE_WARM_STATE_DIR="$WORK/tmp" OP_CACHE_WARM_START=0 OP_CACHE_WARM_END=24 OP_CACHE_WARM_PARTIAL_RETRY=0 "$TOOL" >/dev/null 2>&1 &
script=$!
sleep 1
holder=$(cat "$WORK/tmp/op-cache-warm.lock/pid" 2>/dev/null)
check "lock names the unlock child, not the script" $([[ -n "$holder" && "$holder" != "$script" ]] && kill -0 "$holder" 2>/dev/null && print 1 || print 0) "holder=$holder script=$script"
kill -TERM "$script" 2>/dev/null; wait "$script" 2>/dev/null
sleep 1
check "TERM to the script ends the child" $(kill -0 "$holder" 2>/dev/null && print 0 || print 1) "holder=$holder"
check "lock is gone after TERM" $([[ ! -d "$WORK/tmp/op-cache-warm.lock" ]] && print 1 || print 0)

# 7b. A cold run that ends with a skipped account is retried on the next
#     tick; only a partial retry starts the six-hour wait.
rm -f "$WORK/tmp/op-cache-warm.last-attempt" "$WORK/tmp/op-cache-warm.partial"
out=$(run "$coldskip" OP_CACHE_WARM_START=0 OP_CACHE_WARM_END=24)
out=$(run "$partial" OP_CACHE_WARM_START=0 OP_CACHE_WARM_END=24)
check "partial after a cold run retries at once" $([[ "$out" == *"running unlock"* ]] && print 1 || print 0) "$out"
out=$(run "$partial" OP_CACHE_WARM_START=0 OP_CACHE_WARM_END=24)
check "partial after a partial waits" $([[ "$out" == *"last attempt"* ]] && print 1 || print 0) "$out"

# 8b. A retry that finally covers every account clears the marker.
out=$(run "$cold" OP_CACHE_WARM_START=0 OP_CACHE_WARM_END=24)
check "a complete unlock clears the marker" $([[ ! -f "$WORK/tmp/op-cache-warm.partial" && ! -f "$WORK/tmp/op-cache-warm.last-attempt" ]] && print 1 || print 0) "$out"

# 9. A locked screen skips, whatever the cache says.
out=$(env OP_CACHE_WARM_SCREEN_LOCKED_CMD=true OP_CACHE_BIN="$cold" OP_CACHE_WARM_STATE_DIR="$WORK/tmp" OP_CACHE_WARM_START=0 OP_CACHE_WARM_END=24 "$TOOL" 2>&1)
check "locked screen skips" $([[ "$out" == *"screen locked"* && "$out" != *"running unlock"* ]] && print 1 || print 0) "$out"

print
if (( failures )); then
    print "$failures failed"
    exit 1
fi
print "all passed"
