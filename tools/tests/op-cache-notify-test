#!/usr/bin/env python3
"""Tests for op-cache-notify, run against synthetic audit logs.

Each case states what must be notified AND what must stay silent: a watcher
that only ever fires is as useless as one that never does, and neither shows up
in a run that checks a single direction.

The watcher counts from its state file, so most cases run twice: a first run
that only builds the baseline, then the run that must decide.
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
import tempfile
from datetime import datetime, timedelta, timezone
from pathlib import Path

TOOL = Path(__file__).resolve().parents[1] / "op-cache-notify"
NOW = datetime.now(timezone.utc)

failures: list[str] = []


def entry(minutes_ago: float, subject: str | None = None, kind: str = "secret") -> str:
    moment = (NOW - timedelta(minutes=minutes_ago)).strftime("%Y-%m-%dT%H:%M:%SZ")
    secrets = [{"name": "read", "reference": subject}] if subject else []
    return json.dumps(
        {
            "timestamp": moment,
            "event": "proxy",
            "profile": "_proxy",
            "account": "",
            "secrets": secrets,
            "subcommand": "read",
            "cacheKind": kind,
            "cacheHit": True,
            "caller": {"pid": 1, "path": "/bin/zsh"},
        }
    )


class Case:
    """One temporary directory with its own log, state and config."""

    def __init__(self, config: dict | None = None) -> None:
        self.directory = Path(tempfile.mkdtemp())
        self.state = self.directory / "state.json"
        self.log = self.directory / "audit.jsonl"
        self.config = self.directory / "notify.json"
        if config is not None:
            self.config.write_text(json.dumps(config))

    def run(self, lines: list[str], log: Path | None = None) -> list[str]:
        target = log or self.log
        target.write_text("\n".join(lines) + ("\n" if lines else ""))
        environment = dict(os.environ)
        environment["OP_CACHE_AUDIT_LOG"] = str(target)
        environment["OP_CACHE_NOTIFY_STATE"] = str(self.state)
        environment["OP_CACHE_NOTIFY_CONFIG"] = str(self.config)
        result = subprocess.run(
            [sys.executable, str(TOOL), "--dry-run"],
            capture_output=True,
            text=True,
            env=environment,
            check=False,
        )
        if result.returncode != 0:
            raise AssertionError(f"exit {result.returncode}: {result.stderr}")
        return [line for line in result.stdout.splitlines() if line.startswith("NOTIFY")]

    def baseline(self, lines: list[str]) -> list[str]:
        """The first run never notifies; it records what is already routine."""
        notifications = self.run(lines)
        check("baseline run stays silent", notifications == [], str(notifications))
        return lines


def check(name: str, condition: bool, detail: str = "") -> None:
    if condition:
        print(f"ok   {name}")
    else:
        print(f"FAIL {name} {detail}")
        failures.append(name)


# 1. A reference fetched all week is not named; one never seen before is.
case = Case()
history = case.baseline([entry(60 * 24 * d, "op://Employee/routine/credential") for d in range(1, 6)])
check(
    "routine reference stays silent",
    case.run(history + [entry(1, "op://Employee/routine/credential")]) == [],
)

case = Case()
history = case.baseline([entry(600, "op://Employee/routine/credential")])
notifications = case.run(history + [entry(1, "op://Employee/fremd/credential")])
check(
    "an unseen reference is named",
    len(notifications) == 1 and "op://Employee/fremd/credential" in notifications[0],
    str(notifications),
)

# 2. The threshold counts what came before: two prior requests still notify,
#    three do not.
case = Case()
history = case.baseline([entry(600, "op://E/x/c"), entry(500, "op://E/x/c")])
check("two prior requests still notify", len(case.run(history + [entry(1, "op://E/x/c")])) == 1)

case = Case()
history = case.baseline([entry(600, "op://E/x/c"), entry(500, "op://E/x/c"), entry(400, "op://E/x/c")])
check("three prior requests stay silent", case.run(history + [entry(1, "op://E/x/c")]) == [])

# 3. Requests older than the window stop counting as routine.
case = Case({"rare_window_days": 1})
history = case.baseline([entry(60 * 30, "op://E/alt/c") for _ in range(5)])
check(
    "requests outside the window do not count",
    len(case.run(history + [entry(1, "op://E/alt/c")])) == 1,
)

# 4. Every kind that reaches or enumerates a credential is named, including the
#    listing that a foreign process would use to orient itself.
for kind in ("secret", "item-store", "metadata", "passthrough", "mutating"):
    case = Case()
    case.baseline([entry(600, "op://E/anders/c")])
    check(
        f"{kind} calls are named",
        len(case.run([entry(600, "op://E/anders/c"), entry(1, "op://E/neu/c", kind=kind)])) == 1,
    )

# 5. The first run builds a baseline instead of announcing the whole week.
case = Case()
check("a first run never notifies", case.run([entry(1, f"op://E/i{i}/c") for i in range(5)]) == [])

# 6. The burst check counts every request, cached or not.
case = Case({"rare_threshold": 0, "rate_threshold": 50})
case.baseline([])
notifications = case.run([entry(30, f"op://E/i{i}/c") for i in range(60)])
check("a burst above the threshold warns", any("Stunde" in n for n in notifications), str(notifications))

case = Case({"rare_threshold": 0, "rate_threshold": 50})
case.baseline([])
check(
    "below the threshold stays silent",
    case.run([entry(30, f"op://E/i{i}/c") for i in range(40)]) == [],
)

case = Case({"rare_threshold": 0, "rate_threshold": 50})
case.baseline([])
check(
    "a burst an hour ago no longer warns",
    case.run([entry(120, f"op://E/i{i}/c") for i in range(60)]) == [],
)

# 7. The burst warning does not repeat inside its cooldown.
case = Case({"rare_threshold": 0, "rate_threshold": 50, "rate_cooldown_minutes": 60})
case.baseline([])
lines = [entry(30, f"op://E/i{i}/c") for i in range(60)]
first = case.run(lines)
second = case.run(lines + [entry(0.5, "op://E/i0/c")])
check("burst warns once", len(first) == 1, str(first))
check("burst does not repeat in the cooldown", second == [], str(second))

# 8. An entry is named once, not on every run.
case = Case()
history = case.baseline([entry(600, "op://E/routine/c")])
lines = history + [entry(5, "op://E/einmal/c")]
first = case.run(lines)
second = case.run(lines)
check("a request is named once", len(first) == 1 and second == [], f"{first} then {second}")

# 9. A rotated log neither re-counts its history nor swallows what follows.
case = Case()
history = case.baseline([entry(600, f"op://E/i{i}/c") for i in range(3)])
case.run(history + [entry(30, "op://E/vorher/c")])
rotated = case.directory / "audit2.jsonl"
after = case.run([entry(2, "op://E/nach-rotation/c")], log=rotated)
check(
    "after rotation the new entry is named",
    len(after) == 1 and "nach-rotation" in after[0],
    str(after),
)
case_state = json.loads(case.state.read_text())
check(
    "rotation does not double-count the history",
    all(len(v) <= 1 for k, v in case_state["history"].items()),
    str(case_state["history"]),
)

# 10. Broken input is skipped, not fatal.
case = Case()
case.baseline([entry(600, "op://E/routine/c")])
broken = [
    entry(600, "op://E/routine/c"),
    '{"timestamp": "abgeschnitten"',
    "",
    json.dumps({"timestamp": "kein-datum", "secrets": []}),
    json.dumps({"timestamp": "2026-01-01T00:00:00Z", "secrets": "kein-array"}),
    entry(1, "op://E/nach-kaputt/c"),
]
notifications = case.run(broken)
check("broken lines are skipped", len(notifications) == 1 and "nach-kaputt" in notifications[0], str(notifications))

# 11. A broken state file is treated as no state, not as a crash.
case = Case()
case.state.write_text("kaputt")
check("a broken state file is survivable", case.run([entry(1, "op://E/x/c")]) == [])

# 12. A missing log is not an error.
case = Case()
missing = case.directory / "nothing.jsonl"
environment = dict(os.environ)
environment.update(
    {
        "OP_CACHE_AUDIT_LOG": str(missing),
        "OP_CACHE_NOTIFY_STATE": str(case.state),
        "OP_CACHE_NOTIFY_CONFIG": str(case.config),
    }
)
result = subprocess.run(
    [sys.executable, str(TOOL), "--dry-run"], capture_output=True, text=True, env=environment
)
check("a missing log exits clean", result.returncode == 0 and result.stdout == "")

# 13. Disabled means silent.
case = Case({"enabled": False})
check("enabled:false silences everything", case.run([entry(1, "op://E/x/c")]) == [])

# 14. Concurrent runs do not both count the same entries.
case = Case()
history = case.baseline([entry(600, "op://E/routine/c")])
lines = history + [entry(2, "op://E/parallel/c")]
case.log.write_text("\n".join(lines) + "\n")
environment = dict(os.environ)
environment.update(
    {
        "OP_CACHE_AUDIT_LOG": str(case.log),
        "OP_CACHE_NOTIFY_STATE": str(case.state),
        "OP_CACHE_NOTIFY_CONFIG": str(case.config),
    }
)
processes = [
    subprocess.Popen(
        [sys.executable, str(TOOL), "--dry-run"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        env=environment,
    )
    for _ in range(5)
]
outputs = [process.communicate()[0] for process in processes]
named = sum(line.startswith("NOTIFY") for output in outputs for line in output.splitlines())
check("five concurrent runs name it once", named == 1, f"{named} notifications")

# 15. The lock does not survive its holder for ever.
case = Case()
case.baseline([entry(600, "op://E/routine/c")])
stale = case.state.with_suffix(".lock")
stale.write_text("999999")
old = (datetime.now() - timedelta(hours=2)).timestamp()
os.utime(stale, (old, old))
check(
    "a stale lock is broken",
    len(case.run([entry(600, "op://E/routine/c"), entry(1, "op://E/nach-lock/c")])) == 1,
)

# ---- Findings of the adversarial review, each with its own case ----

# 16. A request older than an hour is still reported: the watcher may have been
#     asleep with the Mac, and that is the one it must not swallow.
case = Case()
history = case.baseline([entry(600, "op://E/routine/c")])
check(
    "an old unseen request is still named",
    len(case.run(history + [entry(90, "op://E/verschlafen/c")])) == 1,
)

# 17. A state file from the version that kept no history is a first run.
case = Case()
case.state.write_text(json.dumps({"offset": 0, "last_run": "2026-01-01T00:00:00Z"}))
check(
    "a history-less state file starts a baseline",
    case.run([entry(1, f"op://E/i{i}/c") for i in range(5)]) == [],
)

# 18. A wrongly typed config key falls back instead of crashing every minute.
case = Case({"rate_threshold": "viele", "rare_threshold": 3})
case.baseline([entry(600, "op://E/routine/c")])
notifications = case.run([entry(600, "op://E/routine/c"), entry(1, "op://E/neu/c")])
check("a wrongly typed config key falls back", len(notifications) == 1, str(notifications))

# 19. The state mirrors the log's references and gets the log's mode.
case = Case()
case.run([entry(1, "op://E/x/c")])
mode = case.state.stat().st_mode & 0o777
check("state file is private", mode == 0o600, oct(mode))

# 20. An entry with an unreadable timestamp that names a secret is not dropped.
case = Case()
history = case.baseline([entry(600, "op://E/routine/c")])
line = json.loads(entry(1, "op://E/ohne-uhr/c"))
line["timestamp"] = "kein-datum"
notifications = case.run(history + [json.dumps(line)])
check("a bad timestamp does not hide a request", len(notifications) == 1 and "ohne-uhr" in notifications[0], str(notifications))

# 21. The banner says which request number this is, and lists least-seen first;
#     the full list goes to stdout even when the banner is cut.
case = Case({"max_named_subjects": 2})
history = case.baseline([entry(600, "op://E/zwei/c"), entry(500, "op://E/zwei/c")])
lines = history + [entry(3, "op://E/zwei/c"), entry(2, "op://E/null-b/c"), entry(1, "op://E/null-a/c")]
target = case.log
target.write_text("\n".join(lines) + "\n")
environment = dict(os.environ)
environment.update(
    {
        "OP_CACHE_AUDIT_LOG": str(target),
        "OP_CACHE_NOTIFY_STATE": str(case.state),
        "OP_CACHE_NOTIFY_CONFIG": str(case.config),
    }
)
out = subprocess.run(
    [sys.executable, str(TOOL), "--dry-run"], capture_output=True, text=True, env=environment
).stdout
banner = [l for l in out.splitlines() if l.startswith("NOTIFY")]
rare_lines = [l for l in out.splitlines() if l.startswith("RARE")]
check(
    "banner lists least-seen first with the request number",
    len(banner) == 1 and "op://E/null-a/c (1.)" in banner[0] and "op://E/null-b/c (1.)" in banner[0]
    and "zwei" not in banner[0] and "und 1 weitere" in banner[0],
    str(banner),
)
check(
    "every rare subject reaches stdout, cut or not",
    sorted(l.split("\t")[2] for l in rare_lines) == ["op://E/null-a/c", "op://E/null-b/c", "op://E/zwei/c"]
    and any(l.startswith("RARE\t3\top://E/zwei/c") for l in rare_lines),
    str(rare_lines),
)


# ---- Findings of the second adversarial round ----

# 22. A state written by an older version (history present, no version) is a
#     first run: its history is shorter than the week and would raise false alarms.
case = Case()
case.state.write_text(json.dumps({"offset": 0, "history": {"op://E/x/c": []}}))
check(
    "a versionless state starts a baseline",
    case.run([entry(1, f"op://E/i{i}/c") for i in range(5)]) == [],
)
check("the state now carries its version", json.loads(case.state.read_text()).get("version") == 2)

# 23. The baseline run is silent on bursts too; the next tick reports one.
case = Case({"rare_threshold": 0, "rate_threshold": 50})
lines = [entry(30, f"op://E/i{i}/c") for i in range(60)]
first = case.run(lines)
second = case.run(lines + [entry(0.5, "op://E/i0/c")])
check("baseline run does not warn about a burst", first == [], str(first))
check("the next tick does", any("Stunde" in n for n in second), str(second))

# 24. Entries from before the proxy named its subject count by subcommand, so
#     `item list` is routine across the upgrade instead of new.
case = Case()
old = []
for minutes in (600, 500, 400):
    line = json.loads(entry(minutes, None, kind="metadata"))
    line["subcommand"] = "item list"
    old.append(json.dumps(line))
case.baseline(old)
check(
    "old subcommand-only entries make the subcommand routine",
    case.run(old + [entry(1, "item list", kind="metadata")]) == [],
)

# ---- Findings of the third adversarial round ----

# 25. `run` and `unlock` events have no cacheKind and reach secrets all the same.
for event in ("run", "unlock"):
    case = Case()
    case.baseline([entry(600, "op://E/routine/c")])
    line = json.loads(entry(1, "op://E/profil-secret/c"))
    line["event"] = event
    del line["cacheKind"]
    notifications = case.run([entry(600, "op://E/routine/c"), json.dumps(line)])
    check(
        f"{event} events are named",
        len(notifications) == 1 and "profil-secret" in notifications[0],
        str(notifications),
    )

# 26. A burst leaves a durable line on stdout, not only a banner.
case = Case({"rare_threshold": 0, "rate_threshold": 50})
case.baseline([])
lines = [entry(30, f"op://E/i{i}/c") for i in range(60)]
case.log.write_text("\n".join(lines) + "\n")
environment = dict(os.environ)
environment.update(
    {
        "OP_CACHE_AUDIT_LOG": str(case.log),
        "OP_CACHE_NOTIFY_STATE": str(case.state),
        "OP_CACHE_NOTIFY_CONFIG": str(case.config),
    }
)
out = subprocess.run(
    [sys.executable, str(TOOL), "--dry-run"], capture_output=True, text=True, env=environment
).stdout
check("a burst is recorded on stdout", any(l.startswith("BURST\t60\t50") for l in out.splitlines()), out)

# ---- Findings of the fourth adversarial round ----

# 27. A late writer whose timestamp predates the last seen one is still named
#     on an intact log; only a rotation applies the timestamp filter.
case = Case()
case.baseline([entry(600, "op://A/routine/c")])
lines = [entry(600, "op://A/routine/c"), entry(5, "op://B/neu/c")]
case.run(lines)
late = lines + [entry(7, "op://C/nachzuegler/c")]
notifications = case.run(late)
check("a late writer with an older stamp is named", len(notifications) == 1 and "nachzuegler" in notifications[0], str(notifications))

# 28. The prefetch unlock names itself.
case = Case()
case.baseline([entry(600, "op://A/routine/c")])
prefetch = json.loads(entry(1, None, kind="item-store"))
prefetch["event"] = "unlock"
prefetch["subcommand"] = "prefetch"
notifications = case.run([entry(600, "op://A/routine/c"), json.dumps(prefetch)])
check("a prefetch unlock is named", len(notifications) == 1 and "prefetch" in notifications[0], str(notifications))

# 29. Control characters in a subject cannot forge a second stdout record.
case = Case()
case.baseline([entry(600, "op://A/routine/c")])
case.log.write_text("\n".join([entry(600, "op://A/routine/c"), entry(1, "op://X/a\tRARE\t9\tgefaelscht")]) + "\n")
environment = dict(os.environ)
environment.update({"OP_CACHE_AUDIT_LOG": str(case.log), "OP_CACHE_NOTIFY_STATE": str(case.state), "OP_CACHE_NOTIFY_CONFIG": str(case.config)})
out = subprocess.run([sys.executable, str(TOOL), "--dry-run"], capture_output=True, text=True, env=environment).stdout
rare_lines = [l for l in out.splitlines() if l.startswith("RARE")]
check("a tab in a subject stays inside its field", len(rare_lines) == 1 and rare_lines[0].count("\t") == 2, str(rare_lines))

# ---- Findings of the fifth adversarial round ----

# 30. A rotated log that has already outgrown the old offset is still seen as
#     new (different file), so nothing written to it is skipped.
case = Case()
case.baseline([entry(600, "op://A/routine/c")])
case.run([entry(600, "op://A/routine/c")])  # offset now covers one line
rotated = case.directory / "audit-neu.jsonl"
bigger = [entry(3, f"op://N/verloren-{i}/c") for i in range(4)]
notifications = case.run(bigger, log=rotated)
check(
    "a rotated log larger than the old offset loses nothing",
    len(notifications) == 1 and "4 seltene" in notifications[0],
    str(notifications),
)

# 30b. What was written to the old log between the last tick and the rename is
#      read from `<log>.1` before the new file, and named.
case = Case()
case.baseline([entry(600, "op://A/routine/c")])
case.run([entry(600, "op://A/routine/c")])
with case.log.open("a") as handle:
    handle.write(entry(2, "op://F/im-alten-log/c") + "\n")
case.log.rename(case.log.with_name(case.log.name + ".1"))
notifications = case.run([entry(1, "op://A/routine/c")])
check(
    "the tail of the rotated log is named",
    len(notifications) == 1 and "im-alten-log" in notifications[0],
    str(notifications),
)
second = case.run([entry(1, "op://A/routine/c"), entry(0.5, "op://G/danach/c")])
check("after the rotation counting continues", len(second) == 1 and "danach" in second[0], str(second))

# 31. Direction-override characters cannot reshape the banner text.
case = Case()
case.baseline([entry(600, "op://A/routine/c")])
notifications = case.run([entry(600, "op://A/routine/c"), entry(1, "op://X/v‮tide/c")])
check("a format character is stripped from the banner", len(notifications) == 1 and "‮" not in notifications[0], repr(notifications))

# 32. max_named_subjects below one still names one.
case = Case({"max_named_subjects": 0})
case.baseline([entry(600, "op://A/routine/c")])
notifications = case.run([entry(600, "op://A/routine/c"), entry(1, "op://X/a/c"), entry(1, "op://X/b/c")])
check("max_named_subjects 0 still names one", len(notifications) == 1 and "op://X/a/c (1.)" in notifications[0] and "und 1 weitere" in notifications[0], str(notifications))

print()
if failures:
    print(f"{len(failures)} failed: {', '.join(failures)}")
    sys.exit(1)
print("all passed")
